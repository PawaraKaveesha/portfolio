---
import { profile } from '../data/profile';
---

<section id="about" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-bg">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="reveal-on-scroll max-w-2xl mb-16 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-surface border border-white/10 text-xs font-mono text-brand-blue">
        <span>01</span>
        <span>//</span>
        <span>ABOUT PAWARA</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold font-display text-white tracking-tight">
        {profile.aboutHeadline}
      </h2>
      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Connecting engineering rigor with creative expression and community leadership.
      </p>
    </div>

    <!-- Editorial Layout: Bio & Replaceable Visual Asset -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Editorial Content (7 cols) -->
      <div class="lg:col-span-7 space-y-6 reveal-on-scroll">
        <p class="text-xl sm:text-2xl font-display font-semibold text-white leading-snug">
          {profile.aboutIntro}
        </p>

        <div class="space-y-4 text-brand-muted text-base sm:text-lg leading-relaxed">
          {profile.bioParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <!-- Currently Exploring Tag Cloud -->
        <div class="pt-4 border-t border-white/10">
          <p class="text-xs font-mono uppercase tracking-wider text-brand-blue mb-3">
            Currently Exploring &amp; Researching:
          </p>
          <div class="flex flex-wrap gap-2">
            {profile.currentlyExploring.map((item) => (
              <span class="px-3 py-1.5 rounded-lg bg-brand-surface border border-white/10 text-xs font-mono text-brand-text hover:border-brand-blue/40 transition-colors">
                # {item}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Profile Visual Placeholder (5 cols) -->
      <div class="lg:col-span-5 reveal-on-scroll">
        <div class="relative max-w-md mx-auto">
          <!-- Ambient backlight -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-brand-blue via-transparent to-brand-orange opacity-40 blur-xl"></div>

          <!-- Card Wrapper -->
          <div class="relative glass-card rounded-2xl p-6 sm:p-8 space-y-6">
            <!-- Profile Monogram / Visual Placeholder -->
            <div class="relative aspect-square rounded-xl overflow-hidden bg-brand-surface border border-white/10 flex items-center justify-center p-4">
              <img
                src={profile.image.src}
                alt={profile.image.alt}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>

            <!-- Replaceable Instruction Note -->
            <div class="rounded-xl bg-brand-surface/70 border border-white/10 p-3.5 text-xs text-brand-muted space-y-1">
              <div class="flex items-center gap-1.5 text-brand-blue font-semibold">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Profile Image Asset</span>
              </div>
              <p class="leading-relaxed">
                {profile.image.caption}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 4 Professional Dimensions -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 pt-20">
      {profile.dimensions.map((dim, idx) => (
        <div
          class={`reveal-on-scroll glass-card rounded-2xl p-6 space-y-4 transition-all duration-300 ${
            dim.color === 'blue' ? 'glass-card-hover' : 'glass-card-hover-orange'
          }`}
          style={`transition-delay: ${idx * 100}ms;`}
        >
          <div class="flex items-center justify-between">
            <span
              class={`w-10 h-10 rounded-xl flex items-center justify-center text-sm font-mono font-bold ${
                dim.color === 'blue'
                  ? 'bg-brand-blue/15 text-brand-blue border border-brand-blue/30'
                  : 'bg-brand-orange/15 text-brand-orange border border-brand-orange/30'
              }`}
            >
              0{idx + 1}
            </span>
            <span
              class={`text-xs font-mono px-2 py-0.5 rounded-full ${
                dim.color === 'blue' ? 'text-blue-400 bg-blue-500/10' : 'text-orange-400 bg-orange-500/10'
              }`}
            >
              Dimension
            </span>
          </div>

          <h3 class="text-lg font-bold font-display text-white">
            {dim.title}
          </h3>

          <p class="text-brand-muted text-sm leading-relaxed">
            {dim.description}
          </p>

          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-white/5">
            {dim.tags.map((tag) => (
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-brand-surface text-brand-muted border border-white/5">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
