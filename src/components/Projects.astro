---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import { Github, Sparkles, Terminal, Code2, ArrowUpRight } from 'lucide-astro';

const categories = [
  'All',
  'Cybersecurity',
  'Web Development',
  'Software Engineering',
  'Python Development',
  'Digital Solutions',
];

const featuredProjects = projects.filter((p) => p.featured);
const remainingProjects = projects.filter((p) => !p.featured);
---

<section id="projects" class="py-20 sm:py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-bg">
  
  <!-- Subtle Section Divider -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-[1px] bg-gradient-to-r from-transparent via-brand-blue/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-surface border border-white/10 text-xs font-mono text-brand-blue">
        <span>03</span>
        <span class="text-white/30">//</span>
        <span>SOFTWARE &amp; SECURITY PORTFOLIO</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tight">
        Turning concepts into working software.
      </h2>

      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Curated showcase of academic security research, deployed web architectures, and software prototypes. Verified across my GitHub commit history.
      </p>
    </div>

    <!-- Category Filter Controls -->
    <div class="flex flex-wrap items-center gap-2 pt-1">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            data-project-filter={cat}
            class={`px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all duration-200 border ${
              idx === 0
                ? 'bg-brand-blue text-white border-brand-blue shadow-glow-blue'
                : 'bg-brand-card text-brand-muted border-white/10 hover:text-white hover:border-white/25 hover:bg-brand-surface'
            }`}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- Featured Case Studies Showcase (Wide Bento Layout) -->
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-2 border-b border-white/10">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-blue animate-pulse"></span>
          <h3 class="text-xs font-mono uppercase tracking-wider text-white/90">
            Featured Systems &amp; Primary Architectures
          </h3>
        </div>
        <span class="text-xs font-mono text-brand-muted">
          {featuredProjects.length} Highlighted
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} featured={true} />
        ))}
      </div>
    </div>

    <!-- Additional Repositories & Prototypes (Compact Grid) -->
    <div class="space-y-6 pt-6">
      <div class="flex items-center justify-between pb-2 border-b border-white/10">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-muted"></span>
          <h3 class="text-xs font-mono uppercase tracking-wider text-brand-muted">
            Supporting Repositories, Concepts &amp; Utilities
          </h3>
        </div>
        <span class="text-xs font-mono text-brand-muted">
          {remainingProjects.length} Repositories
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {remainingProjects.map((project) => (
          <ProjectCard project={project} featured={false} />
        ))}
      </div>
    </div>

    <!-- Direct GitHub CTA Card -->
    <div class="reveal-on-scroll glass-card rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 border-brand-blue/30 shadow-card-subtle">
      <div class="space-y-2 text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2 text-xs font-mono text-brand-blue">
          <Code2 class="w-4 h-4" />
          <span>OPEN REPOSITORIES</span>
        </div>
        <h4 class="text-xl font-bold font-display text-white">
          Review commit history and codebases on GitHub
        </h4>
        <p class="text-xs sm:text-sm text-brand-muted max-w-xl">
          All repositories, security analysis writeups, modular Python code, and application prototypes are open for peer review and collaboration.
        </p>
      </div>

      <a
        href="https://github.com/PawaraKaveesha"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-brand-surface hover:bg-brand-elevated border border-white/15 text-white text-xs font-semibold hover:border-brand-blue/50 transition-all duration-200 shadow-glow-blue/20 hover:shadow-glow-blue flex-shrink-0"
      >
        <Github class="w-4 h-4 text-brand-blue" />
        <span>github.com/PawaraKaveesha</span>
        <ArrowUpRight class="w-3.5 h-3.5 text-brand-muted" />
      </a>
    </div>

  </div>
</section>
