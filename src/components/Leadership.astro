---
import { leadershipItems } from '../data/leadership';
import { Award, Film, Users, Trophy, Sparkles, CheckCircle2 } from 'lucide-astro';
---

<section id="leadership" class="py-20 sm:py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-surface/30">
  
  <!-- Subtle Section Divider -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-[1px] bg-gradient-to-r from-transparent via-brand-blue/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-card border border-white/10 text-xs font-mono text-brand-blue">
        <span>06</span>
        <span class="text-white/30">//</span>
        <span>LEADERSHIP &amp; COMMUNITY INVOLVEMENT</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tight">
        Beyond code — leadership in action.
      </h2>

      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Active governance in IEEE student branches, hackathon finance operations, creative event direction, and collaborative campus initiatives.
      </p>
    </div>

    <!-- Leadership Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        leadershipItems.map((item, idx) => (
          <div
            class={`reveal-on-scroll glass-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between space-y-5 transition-all duration-300 ${
              item.accent === 'orange' ? 'glass-card-hover-orange' : 'glass-card-hover'
            }`}
            style={`transition-delay: ${idx * 60}ms;`}
          >
            <div class="space-y-4">
              <!-- Top Category & Role Badge -->
              <div class="flex items-center justify-between">
                <span
                  class={`text-[10px] font-mono px-2.5 py-0.5 rounded-full border ${
                    item.accent === 'orange'
                      ? 'bg-brand-orange/15 text-brand-orange border-brand-orange/30'
                      : 'bg-brand-blue/15 text-brand-blue border-brand-blue/30'
                  }`}
                >
                  {item.category}
                </span>

                <div class="p-1.5 rounded-lg bg-brand-surface border border-white/5">
                  {item.category === 'Competition' && <Trophy class="w-3.5 h-3.5 text-brand-blue" />}
                  {item.category === 'Creative' && <Film class="w-3.5 h-3.5 text-brand-orange" />}
                  {item.category === 'Community' && <Users class="w-3.5 h-3.5 text-brand-blue" />}
                  {item.category === 'University' && <Award class="w-3.5 h-3.5 text-brand-cyan" />}
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold font-display text-white">
                  {item.role}
                </h3>
                <p class="text-xs font-mono text-brand-blue mt-0.5">
                  {item.eventOrContext}
                </p>
                <p class="text-[11px] font-mono text-brand-muted mt-0.5">
                  {item.organization}
                </p>
              </div>

              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed line-clamp-3">
                {item.description}
              </p>

              <!-- Contributions Bullet Points -->
              <div class="space-y-1.5 pt-2 border-t border-white/5">
                {item.contributions.map((point) => (
                  <div class="flex items-start gap-2 text-xs text-white/90">
                    <span class={item.accent === 'orange' ? 'text-brand-orange font-bold' : 'text-brand-blue font-bold'}>
                      ✓
                    </span>
                    <span class="leading-relaxed">{point}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 pt-4 border-t border-white/5">
              {item.tags.map((tag) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-brand-surface text-brand-muted border border-white/5">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>
