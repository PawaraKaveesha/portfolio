---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const dataJson = JSON.stringify(project);
---

<div
  class="reveal-on-scroll glass-card rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/30 hover:shadow-2xl group"
  data-project-category={project.category}
>
  <!-- Card Header & Image Preview -->
  <div>
    <div class="relative aspect-video w-full overflow-hidden bg-brand-surface border-b border-white/10 flex items-center justify-center p-2">
      <img
        src={project.image}
        alt={project.name}
        class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
      <!-- Category Badge -->
      <div class="absolute top-3 left-3 flex items-center gap-2">
        <span
          class={`px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold tracking-wide border ${
            project.accent === 'orange'
              ? 'bg-brand-orange/20 text-brand-orange border-brand-orange/40'
              : 'bg-brand-blue/20 text-brand-blue border-brand-blue/40'
          }`}
        >
          {project.category}
        </span>
      </div>

      <!-- Status Badge -->
      <div class="absolute top-3 right-3">
        <span
          class={`px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium border ${
            project.status === 'In Progress'
              ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
              : project.status === 'Production'
              ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30'
              : 'bg-brand-surface text-brand-muted border-white/10'
          }`}
        >
          {project.statusBadge}
        </span>
      </div>
    </div>

    <!-- Content Area -->
    <div class="p-6 space-y-3">
      <h3 class="text-xl font-bold font-display text-white group-hover:text-brand-blue transition-colors">
        {project.name}
      </h3>
      <p class="text-xs font-mono text-brand-muted">
        {project.subtitle}
      </p>
      <p class="text-sm text-brand-muted leading-relaxed line-clamp-3">
        {project.shortDescription}
      </p>

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1.5 pt-3">
        {project.technologies.slice(0, 4).map((tech) => (
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-brand-surface text-brand-muted border border-white/5">
            {tech}
          </span>
        ))}
        {project.technologies.length > 4 && (
          <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-brand-surface text-brand-muted">
            +{project.technologies.length - 4}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Footer Actions -->
  <div class="p-6 pt-0 border-t border-white/5 mt-4 flex items-center justify-between gap-3">
    <!-- View Case Study Modal Button -->
    <button
      type="button"
      data-open-project
      data-project-data={dataJson}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-blue hover:text-white transition-colors"
    >
      <span>Case Study</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div class="flex items-center gap-2">
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${project.name} on GitHub`}
          class="p-2 rounded-lg bg-brand-surface text-brand-muted hover:text-white hover:border-brand-blue/30 border border-white/10 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>
      )}

      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View live application for ${project.name}`}
          class="p-2 rounded-lg bg-brand-surface text-brand-orange hover:text-white hover:bg-brand-orange/20 border border-brand-orange/30 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      )}
    </div>
  </div>
</div>
