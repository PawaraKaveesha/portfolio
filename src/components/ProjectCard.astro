---
import type { Project } from '../data/projects';
import TechIcon from './TechIcon.astro';
import { Github, ExternalLink, ArrowUpRight, Terminal, Globe, Shield, Sparkles } from 'lucide-astro';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const dataJson = JSON.stringify(project);
const isWeb = project.category === 'Web Development' || project.category === 'Digital Solutions';
---

<div
  class={`reveal-on-scroll glass-card rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group ${
    project.accent === 'orange'
      ? 'hover:border-brand-orange/40 hover:shadow-glow-orange/20'
      : 'hover:border-brand-blue/40 hover:shadow-glow-blue/20'
  }`}
  data-project-category={project.category}
>
  <div>
    <!-- Realistic Device / Browser Mockup Window Chrome -->
    <div class="border-b border-white/10 bg-brand-surface/90 px-3 py-2.5 flex items-center justify-between">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
      </div>

      <!-- Mockup Address / Console Bar -->
      <div class="px-3 py-0.5 rounded-md bg-brand-bg/80 border border-white/10 text-[10px] font-mono text-brand-muted truncate max-w-[200px] sm:max-w-xs flex items-center gap-1.5">
        {isWeb ? (
          <Globe class="w-3 h-3 text-brand-blue flex-shrink-0" />
        ) : (
          <Terminal class="w-3 h-3 text-brand-blue flex-shrink-0" />
        )}
        <span class="truncate">
          {project.liveUrl ? project.liveUrl.replace('https://', '') : `${project.id}.local`}
        </span>
      </div>

      <!-- Status Indicator Pill -->
      <span
        class={`px-2 py-0.5 rounded-full text-[10px] font-mono font-medium border ${
          project.status === 'Production'
            ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30'
            : project.status === 'In Progress'
            ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
            : 'bg-brand-surface text-brand-muted border-white/10'
        }`}
      >
        {project.statusBadge}
      </span>
    </div>

    <!-- Preview Media Container with Subtle Grid Texture -->
    <div class="relative aspect-video w-full overflow-hidden bg-brand-surface border-b border-white/10 flex items-center justify-center p-2 group-hover:bg-brand-elevated/50 transition-colors">
      <img
        src={project.image}
        alt={project.name}
        class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-card/60 via-transparent to-transparent pointer-events-none"></div>

      <!-- Category Pill Overlay -->
      <div class="absolute top-3 left-3 flex items-center gap-2">
        <span
          class={`px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold tracking-wide border backdrop-blur-md ${
            project.accent === 'orange'
              ? 'bg-brand-orange/20 text-brand-orange border-brand-orange/40'
              : 'bg-brand-blue/20 text-brand-blue border-brand-blue/40'
          }`}
        >
          {project.category}
        </span>
      </div>
    </div>

    <!-- Card Content Area -->
    <div class="p-6 space-y-3">
      <div>
        <h3 class="text-xl font-bold font-display text-white group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>{project.name}</span>
        </h3>
        <p class="text-xs font-mono text-brand-muted mt-0.5">
          {project.subtitle}
        </p>
      </div>

      <p class="text-xs sm:text-sm text-brand-muted leading-relaxed line-clamp-2">
        {project.shortDescription}
      </p>

      <!-- Key Features Highlight for Featured Cards -->
      {featured && (
        <ul class="space-y-1 pt-1 pb-1 text-xs text-white/80">
          {project.keyFeatures.slice(0, 2).map((feat) => (
            <li class="flex items-start gap-1.5">
              <span class={project.accent === 'orange' ? 'text-brand-orange font-bold' : 'text-brand-blue font-bold'}>✓</span>
              <span class="line-clamp-1">{feat}</span>
            </li>
          ))}
        </ul>
      )}

      <!-- Technology Stack Badges with Genuine Brand Icons -->
      <div class="flex flex-wrap gap-1.5 pt-2">
        {project.technologies.slice(0, featured ? 5 : 4).map((tech) => (
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono bg-brand-surface text-brand-text border border-white/5">
            <TechIcon name={tech} class="w-3 h-3" />
            <span>{tech}</span>
          </div>
        ))}
        {project.technologies.length > (featured ? 5 : 4) && (
          <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-brand-surface text-brand-muted">
            +{project.technologies.length - (featured ? 5 : 4)}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Bottom Action Bar -->
  <div class="p-6 pt-0 border-t border-white/5 mt-4 flex items-center justify-between gap-3">
    <!-- View Case Study Trigger -->
    <button
      type="button"
      data-open-project
      data-project-data={dataJson}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-blue hover:text-white transition-colors py-1 group/btn"
    >
      <span>Detailed Case Study</span>
      <ArrowUpRight class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5" />
    </button>

    <div class="flex items-center gap-2">
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${project.name} on GitHub`}
          class="p-2 rounded-lg bg-brand-surface text-brand-muted hover:text-white hover:border-brand-blue/40 border border-white/10 transition-colors shadow-sm"
          title="Inspect Repository on GitHub"
        >
          <Github class="w-3.5 h-3.5" />
        </a>
      )}

      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View live application for ${project.name}`}
          class="p-2 rounded-lg bg-brand-orange/15 text-brand-orange hover:text-white hover:bg-brand-orange border border-brand-orange/40 transition-colors shadow-sm"
          title="Explore Live Deployed Application"
        >
          <ExternalLink class="w-3.5 h-3.5" />
        </a>
      )}
    </div>
  </div>
</div>
