---
import { skillCategories } from '../data/skills';
---

<section id="expertise" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-surface/40">
  <div class="max-w-7xl mx-auto space-y-16">
    <!-- Header -->
    <div class="reveal-on-scroll max-w-2xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-card border border-white/10 text-xs font-mono text-brand-blue">
        <span>02</span>
        <span>//</span>
        <span>TECHNICAL &amp; CREATIVE CAPABILITIES</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold font-display text-white tracking-tight">
        Tools, technologies &amp; things I work with.
      </h2>
      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Categorized overview of practical competencies and actively developing domains. No arbitrary percentage bars—just transparent capability indicators.
      </p>

      <!-- Legend -->
      <div class="flex items-center gap-6 pt-2 text-xs font-mono">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          <span class="text-white/80">Practical Experience</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          <span class="text-white/80">Currently Learning / Lab Exploration</span>
        </div>
      </div>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        skillCategories.map((cat, idx) => (
          <div
            class={`reveal-on-scroll glass-card rounded-2xl p-6 sm:p-7 space-y-6 flex flex-col justify-between transition-all duration-300 ${
              cat.accent === 'orange' ? 'glass-card-hover-orange' : 'glass-card-hover'
            }`}
            style={`transition-delay: ${idx * 80}ms;`}
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span
                  class={`text-xs font-mono uppercase px-2.5 py-1 rounded-md tracking-wider ${
                    cat.accent === 'orange'
                      ? 'bg-brand-orange/15 text-brand-orange border border-brand-orange/30'
                      : 'bg-brand-blue/15 text-brand-blue border border-brand-blue/30'
                  }`}
                >
                  {cat.title}
                </span>
              </div>

              <p class="text-xs text-brand-muted leading-relaxed">
                {cat.description}
              </p>
            </div>

            <!-- Skills List / Badges -->
            <div class="flex flex-wrap gap-2 pt-4 border-t border-white/5">
              {cat.skills.map((skill) => (
                <div
                  class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium border transition-colors ${
                    skill.status === 'practical'
                      ? 'bg-brand-surface/90 border-white/10 text-white hover:border-brand-blue/40'
                      : 'bg-brand-surface/50 border-white/5 text-brand-muted hover:border-amber-400/40'
                  }`}
                >
                  <span
                    class={`w-1.5 h-1.5 rounded-full ${
                      skill.status === 'practical' ? 'bg-emerald-400' : 'bg-amber-400'
                    }`}
                  ></span>
                  <span>{skill.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
