---
import { beyondCodePillars } from '../data/beyondCode';
---

<section id="beyond" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-surface/30">
  <div class="max-w-7xl mx-auto space-y-16">
    <!-- Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-card border border-white/10 text-xs font-mono text-brand-orange">
        <span>08</span>
        <span>//</span>
        <span>MULTIDISCIPLINARY PERSPECTIVE</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold font-display text-white tracking-tight">
        Curiosity doesn't stay in one discipline.
      </h2>
      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        True innovation lives where disciplines intersect. How computer networks, defensive cybersecurity, visual storytelling, and entrepreneurial initiative inform my approach.
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        beyondCodePillars.map((pillar, idx) => (
          <div
            class={`reveal-on-scroll glass-card rounded-2xl p-6 sm:p-7 space-y-4 flex flex-col justify-between transition-all duration-300 ${
              pillar.accent === 'orange' ? 'glass-card-hover-orange' : 'glass-card-hover'
            }`}
            style={`transition-delay: ${idx * 80}ms;`}
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span
                  class={`text-[10px] font-mono uppercase px-2.5 py-1 rounded tracking-wider ${
                    pillar.accent === 'orange'
                      ? 'bg-brand-orange/15 text-brand-orange border border-brand-orange/30'
                      : 'bg-brand-blue/15 text-brand-blue border border-brand-blue/30'
                  }`}
                >
                  {pillar.theme}
                </span>
                <span class="text-xs font-mono text-brand-muted">0{idx + 1}</span>
              </div>

              <h3 class="text-xl font-bold font-display text-white">
                {pillar.title}
              </h3>

              <p class="text-xs sm:text-sm text-white/90 font-medium leading-relaxed">
                "{pillar.statement}"
              </p>
            </div>

            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed pt-3 border-t border-white/5">
              {pillar.details}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
