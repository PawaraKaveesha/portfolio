---
import { mediaItems } from '../data/media';
import MediaCard from './MediaCard.astro';
import { Film, Play, Sparkles, Video, ArrowUpRight } from 'lucide-astro';

const categories = [
  'All',
  'Video Production',
  'Content Creation',
  'Event Media',
  'Graphic Design',
  'Social Media',
  'Creative Direction',
];
---

<section id="media" class="py-20 sm:py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-surface/40 overflow-hidden">
  
  <!-- Subtle Ambient Orange Underglow -->
  <div class="absolute top-1/3 right-1/4 w-[500px] h-[350px] bg-brand-orange/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  
  <!-- Section Divider -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-[1px] bg-gradient-to-r from-transparent via-brand-orange/40 to-transparent"></div>

  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-card border border-brand-orange/30 text-xs font-mono text-brand-orange">
        <span>04</span>
        <span class="text-white/30">//</span>
        <span>CREATIVE &amp; MEDIA PRODUCTION</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tight">
        Behind the frame — my creative work.
      </h2>

      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Professional video editing, podcast post-production, multicam synchronization, and digital storytelling across recognized broadcast channels and digital series.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap items-center gap-2 pt-1">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            data-media-filter={cat}
            class={`px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all duration-200 border ${
              idx === 0
                ? 'bg-brand-orange text-brand-bg font-semibold border-brand-orange shadow-glow-orange'
                : 'bg-brand-card text-brand-muted border-white/10 hover:text-white hover:border-brand-orange/40 hover:bg-brand-surface'
            }`}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- Media Cards Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {mediaItems.map((item) => (
        <MediaCard item={item} />
      ))}
    </div>

    <!-- Creative Discipline & Methodology Highlight Card -->
    <div class="reveal-on-scroll glass-card rounded-2xl p-6 sm:p-8 border-brand-orange/30 flex flex-col md:flex-row items-center justify-between gap-6 shadow-card-subtle relative overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-60 h-60 bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="space-y-2 text-center md:text-left relative z-10">
        <div class="flex items-center justify-center md:justify-start gap-2 text-brand-orange text-xs font-mono uppercase tracking-wider">
          <Film class="w-4 h-4" />
          <span>Post-Production Methodology</span>
        </div>
        <h4 class="text-xl sm:text-2xl font-bold font-display text-white">
          Where Technical Rigor Meets Visual Pacing
        </h4>
        <p class="text-xs sm:text-sm text-brand-muted max-w-2xl leading-relaxed">
          From multi-camera studio recordings for Channel 19 LK to dynamic podcast packaging and vertical explainers, my workflow combines Adobe Premiere Pro, DaVinci Resolve, and After Effects to ensure broadcast-level audio mastered for dynamic headroom, precise narrative pacing, and engaging motion design.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto relative z-10 flex-shrink-0">
        <a
          href="https://www.youtube.com/@Channel19lk"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-brand-surface hover:bg-brand-elevated border border-brand-orange/40 text-white text-xs font-semibold hover:border-brand-orange hover:shadow-glow-orange/30 transition-all"
        >
          <span>Explore Channel 19 LK</span>
          <ArrowUpRight class="w-3.5 h-3.5 text-brand-orange" />
        </a>
      </div>
    </div>

  </div>
</section>
