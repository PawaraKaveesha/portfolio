---
import { mediaItems } from '../data/media';
import MediaCard from './MediaCard.astro';

const categories = [
  'All',
  'Video Production',
  'Content Creation',
  'Event Media',
  'Graphic Design',
  'Social Media',
  'Creative Direction',
];
---

<section id="media" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-surface/40">
  <div class="max-w-7xl mx-auto space-y-16">
    <!-- Section Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-card border border-brand-orange/30 text-xs font-mono text-brand-orange">
        <span>04</span>
        <span>//</span>
        <span>CREATIVE &amp; MEDIA PORTFOLIO</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold font-display text-white tracking-tight">
        Behind the Frame — My Media Work.
      </h2>
      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Media production, video editing, motion design, and digital content creation across prominent broadcast streams, podcasts, and digital channels.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap items-center gap-2 pt-2">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            data-media-filter={cat}
            class={`px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-200 border ${
              idx === 0
                ? 'bg-brand-orange text-brand-bg font-semibold border-brand-orange shadow-glow-orange'
                : 'bg-brand-card text-brand-muted border-white/10 hover:text-white hover:border-white/20'
            }`}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- Media Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {mediaItems.map((item) => (
        <MediaCard item={item} />
      ))}
    </div>

    <!-- Creative Discipline Note Card -->
    <div class="reveal-on-scroll glass-card rounded-2xl p-6 sm:p-8 border-brand-orange/20 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-2 text-brand-orange text-xs font-mono uppercase tracking-wider">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <span>Production Methodology</span>
        </div>
        <h4 class="text-xl font-bold font-display text-white">
          Where Technical Precision Meets Visual Pacing
        </h4>
        <p class="text-sm text-brand-muted max-w-2xl leading-relaxed">
          From multi-camera studio recordings to short-form vertical explainers, my creative work leverages Adobe Premiere Pro, DaVinci Resolve, and After Effects to deliver tight narrative pacing, broadcast-compliant audio, and clear graphic hierarchy.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <a
          href="https://www.youtube.com/@Channel19lk"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-brand-surface hover:bg-brand-elevated border border-white/10 text-white text-xs font-semibold hover:border-brand-orange/40 transition-colors"
        >
          <span>Channel 19 LK</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
