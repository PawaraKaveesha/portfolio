---
import { profile } from '../data/profile';
import { socialLinks } from '../data/social';
---

<section id="contact" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-bg">
  <div class="max-w-7xl mx-auto space-y-16">
    <!-- Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-surface border border-white/10 text-xs font-mono text-brand-blue">
        <span>09</span>
        <span>//</span>
        <span>GET IN TOUCH</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold font-display text-white tracking-tight">
        Have an idea? Let's make something happen.
      </h2>
      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        I'm always interested in connecting with people, collaborating on interesting projects, exploring opportunities, and building meaningful things.
      </p>
    </div>

    <!-- Contact Grid: Left Column Info, Right Column Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Professional Links (5 cols) -->
      <div class="lg:col-span-5 space-y-8 reveal-on-scroll">
        <div class="space-y-4">
          <h3 class="text-xl font-bold font-display text-white">
            Direct Communication Channels
          </h3>
          <p class="text-sm text-brand-muted leading-relaxed">
            Reach out through LinkedIn for professional inquiries, check my public code on GitHub, or send an inquiry directly using the form.
          </p>
        </div>

        <!-- Direct Action Buttons -->
        <div class="space-y-3">
          <!-- LinkedIn Primary CTA -->
          <a
            href={socialLinks.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-4 rounded-xl bg-brand-surface hover:bg-brand-elevated border border-white/10 hover:border-brand-blue/50 transition-all duration-200 group"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-blue-600/20 text-brand-blue flex items-center justify-center font-bold">
                in
              </div>
              <div>
                <p class="text-sm font-semibold text-white group-hover:text-brand-blue transition-colors">
                  Connect on LinkedIn
                </p>
                <p class="text-xs text-brand-muted">
                  Professional network &amp; messaging
                </p>
              </div>
            </div>
            <svg class="w-4 h-4 text-brand-muted group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>

          <!-- GitHub Secondary CTA -->
          <a
            href={socialLinks.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-4 rounded-xl bg-brand-surface hover:bg-brand-elevated border border-white/10 hover:border-white/30 transition-all duration-200 group"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-white/10 text-white flex items-center justify-center">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-white group-hover:text-brand-blue transition-colors">
                  Explore My GitHub
                </p>
                <p class="text-xs text-brand-muted">
                  Public repositories &amp; experiments
                </p>
              </div>
            </div>
            <svg class="w-4 h-4 text-brand-muted group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        </div>

        <!-- Placeholders card for email, whatsapp, instagram -->
        <div class="glass-card rounded-xl p-5 space-y-3">
          <p class="text-xs font-mono uppercase tracking-wider text-brand-blue">
            Contact Information (Editable in social.ts)
          </p>
          <div class="space-y-2 text-xs font-mono">
            <div class="flex items-center justify-between text-brand-muted">
              <span>Email:</span>
              <span class="text-white">{socialLinks.email}</span>
            </div>
            <div class="flex items-center justify-between text-brand-muted">
              <span>Location:</span>
              <span class="text-white">Colombo / Kandy, Sri Lanka</span>
            </div>
            <div class="flex items-center justify-between text-brand-muted">
              <span>Status:</span>
              <span class="text-emerald-400">Available for Opportunities</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Validated Contact Form (7 cols) -->
      <div class="lg:col-span-7 reveal-on-scroll">
        <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
          <div>
            <h3 class="text-xl font-bold font-display text-white">
              Send a Direct Message
            </h3>
            <p class="text-xs text-brand-muted mt-1">
              Fill in your details below. This will prepare a verified direct message dispatch to Pawara.
            </p>
          </div>

          <form id="contact-form" class="space-y-4" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Name Input -->
              <div class="space-y-1.5">
                <label for="name" class="block text-xs font-mono text-brand-muted">
                  Your Name <span class="text-brand-orange">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Alex Silva"
                  class="w-full px-4 py-2.5 rounded-xl bg-brand-surface border border-white/10 text-white text-sm placeholder-brand-muted/50 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors"
                />
              </div>

              <!-- Email Input -->
              <div class="space-y-1.5">
                <label for="email" class="block text-xs font-mono text-brand-muted">
                  Your Email Address <span class="text-brand-orange">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="alex@example.com"
                  class="w-full px-4 py-2.5 rounded-xl bg-brand-surface border border-white/10 text-white text-sm placeholder-brand-muted/50 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors"
                />
              </div>
            </div>

            <!-- Subject Input -->
            <div class="space-y-1.5">
              <label for="subject" class="block text-xs font-mono text-brand-muted">
                Subject <span class="text-brand-orange">*</span>
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                placeholder="Software Collaboration / Media Project / Opportunity"
                class="w-full px-4 py-2.5 rounded-xl bg-brand-surface border border-white/10 text-white text-sm placeholder-brand-muted/50 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors"
              />
            </div>

            <!-- Message Input -->
            <div class="space-y-1.5">
              <label for="message" class="block text-xs font-mono text-brand-muted">
                Your Message <span class="text-brand-orange">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Write your message here..."
                class="w-full px-4 py-2.5 rounded-xl bg-brand-surface border border-white/10 text-white text-sm placeholder-brand-muted/50 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors resize-y"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-brand-blue hover:bg-blue-600 text-white font-semibold text-sm shadow-glow-blue transition-all duration-200 active:scale-95"
            >
              <span>Transmit Message</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </form>

          <!-- Status Message Container -->
          <div id="form-status" class="hidden"></div>
        </div>
      </div>
    </div>
  </div>
</section>
