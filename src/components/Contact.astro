---
import { profile } from '../data/profile';
import { socialLinks } from '../data/social';
import { Linkedin, Github, Mail, MapPin, Send, ArrowUpRight, MessageSquare, ShieldCheck } from 'lucide-astro';
---

<section id="contact" class="py-20 sm:py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-bg">
  
  <!-- Subtle Section Divider -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-[1px] bg-gradient-to-r from-transparent via-brand-blue/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-surface border border-white/10 text-xs font-mono text-brand-blue">
        <span>09</span>
        <span class="text-white/30">//</span>
        <span>COMMAND CONSOLE &amp; DISPATCH</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tight">
        Have a project? Let's connect.
      </h2>

      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Always open to discussing technical architecture, software engineering opportunities, media production collaborations, and creative digital ideas.
      </p>
    </div>

    <!-- Contact Grid: Communication Hub + Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left Column: Professional Direct Hub (5 cols) -->
      <div class="lg:col-span-5 space-y-6 reveal-on-scroll">
        <div class="space-y-3">
          <h3 class="text-xl font-bold font-display text-white">
            Direct Communication Channels
          </h3>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
            Reach out via LinkedIn for professional networking, inspect my repositories on GitHub, or send a message directly using the dispatch form.
          </p>
        </div>

        <!-- Direct Action Channel Cards -->
        <div class="space-y-3">
          
          <!-- LinkedIn Primary Channel -->
          <a
            href={socialLinks.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-4 rounded-xl bg-brand-surface/90 hover:bg-brand-elevated border border-white/10 hover:border-brand-blue/50 transition-all duration-200 group shadow-card-subtle"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-brand-blue flex items-center justify-center border border-blue-500/30">
                <Linkedin class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-semibold text-white group-hover:text-brand-blue transition-colors">
                  Connect on LinkedIn
                </p>
                <p class="text-xs text-brand-muted">
                  Professional network &amp; messaging
                </p>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-brand-muted group-hover:text-white transition-colors" />
          </a>

          <!-- GitHub Channel -->
          <a
            href={socialLinks.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-4 rounded-xl bg-brand-surface/90 hover:bg-brand-elevated border border-white/10 hover:border-white/30 transition-all duration-200 group shadow-card-subtle"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-white/10 text-white flex items-center justify-center border border-white/10">
                <Github class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-semibold text-white group-hover:text-brand-blue transition-colors">
                  Explore GitHub Repositories
                </p>
                <p class="text-xs text-brand-muted">
                  Open-source code &amp; commits
                </p>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-brand-muted group-hover:text-white transition-colors" />
          </a>
        </div>

        <!-- High-Tech Telemetry Node Info Card -->
        <div class="glass-card rounded-2xl p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-white/5">
            <p class="text-xs font-mono uppercase tracking-wider text-brand-blue flex items-center gap-1.5">
              <ShieldCheck class="w-3.5 h-3.5" />
              <span>Contact Telemetry</span>
            </p>
            <span class="text-[10px] font-mono text-emerald-400">ACTIVE DISPATCH</span>
          </div>

          <div class="space-y-2 text-xs font-mono">
            <div class="flex items-center justify-between text-brand-muted">
              <span>Direct Email:</span>
              <a href={`mailto:${socialLinks.email}`} class="text-white hover:text-brand-blue transition-colors">
                {socialLinks.email}
              </a>
            </div>
            <div class="flex items-center justify-between text-brand-muted">
              <span>Location:</span>
              <span class="text-white">Colombo / Kandy, Sri Lanka</span>
            </div>
            <div class="flex items-center justify-between text-brand-muted">
              <span>Availability:</span>
              <span class="text-emerald-400">Open for Collaboration</span>
            </div>
            <div class="flex items-center justify-between text-brand-muted">
              <span>Response Time:</span>
              <span class="text-white/80">&lt; 24 Hours</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Direct Dispatch Form (7 cols) -->
      <div class="lg:col-span-7 reveal-on-scroll">
        <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6 shadow-mockup-depth">
          
          <div>
            <div class="flex items-center gap-2 text-xs font-mono text-brand-blue uppercase tracking-wider mb-1">
              <MessageSquare class="w-3.5 h-3.5" />
              <span>Direct Dispatch</span>
            </div>
            <h3 class="text-xl font-bold font-display text-white">
              Send a Verified Inquiry
            </h3>
            <p class="text-xs text-brand-muted mt-1">
              Fill in your message details below. This will prepare a verified direct dispatch to Pawara.
            </p>
          </div>

          <form id="contact-form" class="space-y-4" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Name Input -->
              <div class="space-y-1.5">
                <label for="name" class="block text-xs font-mono text-brand-muted">
                  Your Name <span class="text-brand-orange">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Alex Silva"
                  class="w-full px-4 py-2.5 rounded-xl bg-brand-surface border border-white/10 text-white text-sm placeholder-brand-muted/40 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors"
                />
              </div>

              <!-- Email Input -->
              <div class="space-y-1.5">
                <label for="email" class="block text-xs font-mono text-brand-muted">
                  Your Email Address <span class="text-brand-orange">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="alex@example.com"
                  class="w-full px-4 py-2.5 rounded-xl bg-brand-surface border border-white/10 text-white text-sm placeholder-brand-muted/40 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors"
                />
              </div>
            </div>

            <!-- Subject Input -->
            <div class="space-y-1.5">
              <label for="subject" class="block text-xs font-mono text-brand-muted">
                Inquiry Subject <span class="text-brand-orange">*</span>
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                placeholder="Software Collaboration / Media Production / Technical Opportunity"
                class="w-full px-4 py-2.5 rounded-xl bg-brand-surface border border-white/10 text-white text-sm placeholder-brand-muted/40 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors"
              />
            </div>

            <!-- Message Input -->
            <div class="space-y-1.5">
              <label for="message" class="block text-xs font-mono text-brand-muted">
                Your Message <span class="text-brand-orange">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Describe your project, ideas, or opportunity..."
                class="w-full px-4 py-2.5 rounded-xl bg-brand-surface border border-white/10 text-white text-sm placeholder-brand-muted/40 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors resize-y"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-brand-blue hover:bg-blue-600 text-white font-semibold text-sm shadow-glow-blue transition-all duration-200 active:scale-95 group"
            >
              <span>Transmit Message</span>
              <Send class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
            </button>
          </form>

          <!-- Form Status Feedback Container -->
          <div id="form-status" class="hidden"></div>
        </div>
      </div>

    </div>

  </div>
</section>
