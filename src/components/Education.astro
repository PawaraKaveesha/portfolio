---
import { educationData, certifications } from '../data/education';
import TechIcon from './TechIcon.astro';
import { Award, GraduationCap, CheckCircle2, Shield, Network, ExternalLink } from 'lucide-astro';
---

<section id="education" class="py-20 sm:py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-bg">
  
  <!-- Subtle Section Divider -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-[1px] bg-gradient-to-r from-transparent via-brand-blue/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-surface border border-white/10 text-xs font-mono text-brand-blue">
        <span>07</span>
        <span class="text-white/30">//</span>
        <span>ACADEMIC FOUNDATION &amp; CREDENTIALS</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tight">
        Rigorous engineering foundation.
      </h2>

      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Academic degree curriculum in computer networks paired with continuous cybersecurity and systems training.
      </p>
    </div>

    <!-- Primary Degree Credential Card -->
    <div class="reveal-on-scroll glass-card rounded-2xl p-6 sm:p-10 border-brand-blue/30 relative overflow-hidden shadow-card-subtle">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-brand-blue/10 blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start relative z-10">
        
        <!-- Degree Details (7 cols) -->
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-brand-blue/20 text-brand-blue border border-brand-blue/40 flex items-center gap-1.5">
              <GraduationCap class="w-3.5 h-3.5" />
              <span>{educationData.status}</span>
            </span>
            <span class="text-xs font-mono text-brand-muted">
              {educationData.location}
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-display text-white">
            {educationData.degree}
          </h3>

          <div class="space-y-1 text-sm sm:text-base">
            <p class="text-white font-semibold">
              {educationData.institution}
            </p>
            <p class="text-brand-muted text-xs sm:text-sm font-mono">
              {educationData.affiliation}
            </p>
          </div>

          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed pt-2">
            {educationData.description}
          </p>
        </div>

        <!-- Core Academic Modules (5 cols) -->
        <div class="lg:col-span-5 rounded-xl bg-brand-surface/90 border border-white/10 p-5 sm:p-6 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-white/5">
            <h4 class="text-xs font-mono uppercase tracking-wider text-brand-blue flex items-center gap-1.5">
              <Network class="w-3.5 h-3.5" />
              <span>Core Curriculum Focus</span>
            </h4>
            <span class="text-[10px] font-mono text-brand-muted">6 Core Domains</span>
          </div>

          <div class="space-y-2">
            {educationData.coreModules.map((module) => (
              <div class="flex items-center gap-2.5 text-xs sm:text-sm text-white/90">
                <span class="text-brand-blue font-bold">✓</span>
                <span>{module}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

    <!-- Certifications & Continuous Technical Training -->
    <div class="space-y-6 pt-4">
      <div class="flex items-center justify-between pb-2 border-b border-white/10">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-blue"></span>
          <h3 class="text-xs font-mono uppercase tracking-wider text-white/90">
            Professional Programs &amp; Technical Certifications
          </h3>
        </div>
        <span class="text-xs font-mono text-brand-muted">
          {certifications.length} Programs
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          certifications.map((cert) => (
            <div class="reveal-on-scroll glass-card rounded-2xl p-6 flex flex-col justify-between space-y-4 transition-all duration-300 hover:border-white/20">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span
                    class={`text-xs font-mono px-2.5 py-0.5 rounded-full border ${
                      cert.status === 'Completed'
                        ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30'
                        : cert.status === 'In Progress'
                        ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
                        : 'bg-brand-blue/15 text-brand-blue border-brand-blue/30'
                    }`}
                  >
                    {cert.statusBadge}
                  </span>
                  <span class="text-xs font-mono text-brand-muted">{cert.dateOrPeriod}</span>
                </div>

                <div>
                  <h4 class="text-lg font-bold font-display text-white">
                    {cert.title}
                  </h4>
                  <p class="text-xs font-mono text-brand-muted mt-0.5">
                    Issuer: {cert.issuer}
                  </p>
                </div>

                <p class="text-xs sm:text-sm text-brand-muted leading-relaxed line-clamp-3">
                  {cert.description}
                </p>
              </div>

              <!-- Skills & Credential Slot -->
              <div class="pt-3 border-t border-white/5 space-y-2">
                <div class="flex flex-wrap gap-1.5">
                  {cert.skills.map((skill) => (
                    <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono bg-brand-surface text-brand-muted border border-white/5">
                      <TechIcon name={skill} class="w-3 h-3" />
                      <span>{skill}</span>
                    </div>
                  ))}
                </div>

                {cert.credentialUrl ? (
                  <a
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs text-brand-blue hover:underline pt-1"
                  >
                    <span>Verify Credential</span>
                    <ExternalLink class="w-3 h-3" />
                  </a>
                ) : (
                  <p class="text-[10px] font-mono text-brand-muted/70 italic pt-1">
                    Credential verification URL editable in education.ts upon completion
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>

  </div>
</section>
