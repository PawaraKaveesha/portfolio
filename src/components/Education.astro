---
import { educationData, certifications } from '../data/education';
---

<section id="education" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-bg">
  <div class="max-w-7xl mx-auto space-y-16">
    <!-- Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-surface border border-white/10 text-xs font-mono text-brand-blue">
        <span>07</span>
        <span>//</span>
        <span>ACADEMIC FOUNDATION &amp; CREDENTIALS</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold font-display text-white tracking-tight">
        Building a strong technical foundation.
      </h2>
      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Academic degree curriculum in computer networks paired with continuous cybersecurity and systems training.
      </p>
    </div>

    <!-- Primary Degree Card -->
    <div class="reveal-on-scroll glass-card rounded-2xl p-8 sm:p-10 border-brand-blue/30 relative overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-brand-blue/10 blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start relative z-10">
        <!-- Degree Details (7 cols) -->
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-brand-blue/20 text-brand-blue border border-brand-blue/40">
              {educationData.status}
            </span>
            <span class="text-xs font-mono text-brand-muted">
              {educationData.location}
            </span>
          </div>

          <h3 class="text-2xl sm:text-4xl font-extrabold font-display text-white">
            {educationData.degree}
          </h3>

          <div class="space-y-1 text-sm sm:text-base">
            <p class="text-white font-medium">
              {educationData.institution}
            </p>
            <p class="text-brand-muted">
              {educationData.affiliation}
            </p>
          </div>

          <p class="text-sm text-brand-muted leading-relaxed pt-2">
            {educationData.description}
          </p>
        </div>

        <!-- Core Academic Modules (5 cols) -->
        <div class="lg:col-span-5 rounded-xl bg-brand-surface/80 border border-white/10 p-6 space-y-4">
          <h4 class="text-xs font-mono uppercase tracking-wider text-brand-blue">
            Core Curriculum Focus:
          </h4>
          <div class="space-y-2">
            {educationData.coreModules.map((module) => (
              <div class="flex items-center gap-2.5 text-xs sm:text-sm text-white/90">
                <span class="text-brand-blue">✓</span>
                <span>{module}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Certifications & Ongoing Training -->
    <div class="space-y-6 pt-6">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
        <h3 class="text-xs font-mono uppercase tracking-wider text-white/90">
          Professional Learning &amp; Technical Programs
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          certifications.map((cert) => (
            <div class="reveal-on-scroll glass-card rounded-2xl p-6 sm:p-7 space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span
                    class={`text-xs font-mono px-2.5 py-0.5 rounded-full border ${
                      cert.status === 'Completed'
                        ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30'
                        : cert.status === 'In Progress'
                        ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
                        : 'bg-brand-blue/15 text-brand-blue border-brand-blue/30'
                    }`}
                  >
                    {cert.statusBadge}
                  </span>
                  <span class="text-xs font-mono text-brand-muted">{cert.dateOrPeriod}</span>
                </div>

                <h4 class="text-lg font-bold font-display text-white">
                  {cert.title}
                </h4>
                <p class="text-xs font-mono text-brand-muted">
                  Issuer: {cert.issuer}
                </p>

                <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                  {cert.description}
                </p>
              </div>

              <!-- Skills & Credential slot -->
              <div class="pt-4 border-t border-white/5 space-y-3">
                <div class="flex flex-wrap gap-1.5">
                  {cert.skills.map((skill) => (
                    <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-brand-surface text-brand-muted border border-white/5">
                      {skill}
                    </span>
                  ))}
                </div>

                {cert.credentialUrl ? (
                  <a
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs text-brand-blue hover:underline"
                  >
                    <span>Verify Credential</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </a>
                ) : (
                  <p class="text-[11px] font-mono text-brand-muted/70 italic">
                    Verification credential URL editable in education.ts upon completion
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
