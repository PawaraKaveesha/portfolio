---
import { experiences } from '../data/experience';
import { Film, Cpu, Globe, Rocket, ArrowUpRight, CheckCircle2, MapPin } from 'lucide-astro';
---

<section id="experience" class="py-20 sm:py-24 px-4 sm:px-6 lg:px-8 relative bg-brand-bg">
  
  <!-- Subtle Section Divider -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-[1px] bg-gradient-to-r from-transparent via-brand-blue/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Header -->
    <div class="reveal-on-scroll max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-surface border border-white/10 text-xs font-mono text-brand-blue">
        <span>05</span>
        <span class="text-white/30">//</span>
        <span>PRACTICAL EXECUTION</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tight">
        Learning through real-world delivery.
      </h2>

      <p class="text-brand-muted text-base sm:text-lg leading-relaxed">
        Hands-on experience across studio broadcast media production, enterprise IT hardware diagnostics, full-stack software deployment, and digital initiatives.
      </p>
    </div>

    <!-- Visually Connected Timeline -->
    <div class="relative ml-4 sm:ml-8 pl-6 sm:pl-10 space-y-10">
      
      <!-- Continuous Illuminated Connecting Spine -->
      <div class="absolute left-0 top-3 bottom-3 w-[2px] bg-gradient-to-b from-brand-orange via-brand-blue to-brand-orange/60"></div>

      {
        experiences.map((exp, idx) => (
          <div class="reveal-on-scroll relative group" style={`transition-delay: ${idx * 90}ms;`}>
            
            <!-- Timeline Node Indicator with Dynamic Accent Glow -->
            <div
              class={`absolute -left-[31px] sm:-left-[47px] top-6 w-5 h-5 rounded-full border-4 border-brand-bg transition-transform duration-300 group-hover:scale-125 z-10 flex items-center justify-center ${
                exp.accent === 'orange'
                  ? 'bg-brand-orange shadow-glow-orange ring-2 ring-brand-orange/30'
                  : 'bg-brand-blue shadow-glow-blue ring-2 ring-brand-blue/30'
              }`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
            </div>

            <!-- Experience Glass Card -->
            <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-5 transition-all duration-300 hover:border-white/20 hover:shadow-card-subtle">
              
              <!-- Card Header -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-white/5">
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-1.5">
                    <span
                      class={`px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium border ${
                        exp.accent === 'orange'
                          ? 'bg-brand-orange/15 text-brand-orange border-brand-orange/30'
                          : 'bg-brand-blue/15 text-brand-blue border-brand-blue/30'
                      }`}
                    >
                      {exp.type}
                    </span>
                    <span class="text-xs font-mono text-brand-muted">• {exp.period}</span>
                  </div>

                  <h3 class="text-xl sm:text-2xl font-bold font-display text-white">
                    {exp.role}
                  </h3>

                  <p class="text-xs sm:text-sm font-medium text-brand-muted flex items-center gap-1.5 mt-0.5">
                    <span class="text-white font-semibold">{exp.organization}</span>
                    <span>—</span>
                    <span class="text-brand-muted flex items-center gap-1">
                      <MapPin class="w-3 h-3 text-brand-blue" />
                      {exp.location}
                    </span>
                  </p>
                </div>

                {exp.link && (
                  <a
                    href={exp.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-brand-surface border border-white/10 text-xs font-medium text-brand-muted hover:text-white hover:border-brand-blue/40 transition-colors self-start sm:self-center shadow-sm"
                  >
                    <span>{exp.linkLabel || 'Visit Site'}</span>
                    <ArrowUpRight class="w-3.5 h-3.5" />
                  </a>
                )}
              </div>

              <!-- Summary -->
              <p class="text-xs sm:text-sm text-brand-text leading-relaxed">
                {exp.summary}
              </p>

              <!-- Key Execution Highlights -->
              <div class="space-y-2">
                <p class="text-[11px] font-mono uppercase tracking-wider text-brand-muted">
                  Key Responsibilities &amp; Delivery:
                </p>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs sm:text-sm text-brand-muted">
                  {exp.highlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class={`font-bold mt-0.5 ${exp.accent === 'orange' ? 'text-brand-orange' : 'text-brand-blue'}`}>
                        ✓
                      </span>
                      <span class="leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Skills Badges -->
              <div class="flex flex-wrap gap-1.5 pt-3 border-t border-white/5">
                {exp.skills.map((skill) => (
                  <span class="px-2.5 py-1 rounded text-xs font-mono bg-brand-surface text-brand-muted border border-white/5">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>
